# Copy to .env.local and fill in. Never commit .env.local.
# Validated at runtime by src/lib/env.ts.

# ── Public (inlined into the browser bundle) ────────────────────────────────
# Canonical site URL. Local: http://localhost:3000. On Netlify leave it unset:
# Netlify's own URL variable is used (then siteConfig.url).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and anon (publishable) key.
# Supabase dashboard → Project Settings → API.
# Local stack: `pnpm db:start` prints both.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server only (never prefix with NEXT_PUBLIC_) ────────────────────────────
# Resend API key for the app's emails (welcome, reminders). Production only:
# set in Netlify for the Production context. Unset (deploy previews, local,
# CI), emails are skipped, never sent.
# RESEND_API_KEY=re_...
#
# Added in later phases, as they become needed:
# SUPABASE_SERVICE_ROLE_KEY   Phase 2, Edge Functions / admin tasks only
#
# ── Edge Function secrets (supabase/functions/.env locally; in production set
#    as Supabase Edge Function secrets, not in Netlify) ─────────────────────
# INGEST_USER_AGENT   User-Agent for job-source requests: bot name, site URL
#                     and contact email from src/config/site.ts, e.g.
#                     "<name>-bot/1.0 (+<site url>; <support email>)".
#                     Production: set by the deploy workflow via
#                     scripts/ingest-user-agent.mjs.
# RESEND_API_KEY      Resend API key; with ALERT_EMAIL, failed ingestion runs
# ALERT_EMAIL         email the owner. Production: GitHub secrets, pushed to
#                     Supabase by the deploy workflow.
# ALERT_FROM          Optional sender; defaults to Resend's onboarding address
#                     until the sending domain is verified.
# RESEND_WEBHOOK_SECRET       Phase 6, inbound email.received signature
