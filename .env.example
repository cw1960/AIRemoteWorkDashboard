# Copy to .env.local and fill in. Never commit .env.local.
# Validated at runtime by src/lib/env.ts.

# ── Public (inlined into the browser bundle) ────────────────────────────────
# Canonical site URL for this environment. Defaults to siteConfig.url.
# Local: http://localhost:3000 · Netlify: set per deploy context.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and anon (publishable) key.
# Supabase dashboard → Project Settings → API.
# Local stack: `pnpm db:start` prints both.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server only (never prefix with NEXT_PUBLIC_) ────────────────────────────
# Added in later phases, as they become needed:
# SUPABASE_SERVICE_ROLE_KEY   Phase 2, Edge Functions / admin tasks only
# RESEND_API_KEY              Phase 2, alerts and transactional email
# RESEND_WEBHOOK_SECRET       Phase 6, inbound email.received signature
